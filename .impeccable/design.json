  "narrative": {
    "northStar": "La cabina del DJ",
    "overview": "Track Manager es una herramienta de trabajo, no una vidriera. La app es clara, densa y tranquila: fondo papel, tarjetas blancas, una sola voz de color (el índigo) y tipografía con carácter solo en los títulos. La noche de la cabina aparece en la barra de navegación y en la landing.",
    "keyCharacteristics": [
      "Una sola voz de color: índigo para acción y selección.",
      "Títulos de página en Unbounded; todo lo demás en Instrument Sans.",
      "Estados de track como badges con fondo tenue y texto oscuro del mismo tono.",
      "Íconos de Bootstrap Icons, nunca emojis.",
      "Densidad alta en tablas, aire generoso entre secciones."
    ],
    "rules": [
      {
        "name": "La regla del color que se lee",
        "body": "Un color vivo nunca es texto sobre blanco; se usa su variante oscura.",
        "section": "colors"
      },
      {
        "name": "La regla de una sola voz",
        "body": "El índigo es la única acción; verde, ámbar y rojo informan estados.",
        "section": "colors"
      },
      {
        "name": "La regla del piso de 11px",
        "body": "Ningún texto que el usuario tenga que leer baja de 11px.",
        "section": "typography"
      },
      {
        "name": "La regla de un h1",
        "body": "Un único h1 por página; lo siguiente es h2.",
        "section": "typography"
      },
      {
        "name": "La regla sin halo",
        "body": "Ninguna sombra de color ni resplandor.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar los helpers de la base: confirmSubmit / tmConfirm para confirmar, showToast con Deshacer para acciones reversibles.",
      "Do escribir los estados como badges con su clase.",
      "Do darle a cada botón de ícono un aria-label y un tooltip.",
      "Do usar las variantes oscuras cuando un estado es texto."
    ],
    "donts": [
      "Don't usar emojis como íconos.",
      "Don't usar confirm() del navegador.",
      "Don't poner franjas de color en el borde izquierdo de tarjetas, filas o avisos.",
      "Don't usar sombras de color ni resplandores.",
      "Don't bajar de 11px en texto que se lee."
    ]
  }
